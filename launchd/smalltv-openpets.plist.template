<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Rendered by launchd/install.sh; the screen IP comes from ~/.config/smalltv-openpets/config.json -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>__LABEL__</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/python3</string>
		<string>-u</string>
		<string>__PROJECT__/bridge.py</string>
	</array>
	<key>WorkingDirectory</key>
	<string>__PROJECT__</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>ProcessType</key>
	<string>Background</string>
	<key>StandardOutPath</key>
	<string>__HOME__/Library/Logs/smalltv-openpets.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/Library/Logs/smalltv-openpets.log</string>
</dict>
</plist>
